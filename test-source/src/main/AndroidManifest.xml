    <application android:label="Probe Test Source" android:allowAudioPlaybackCapture="true" android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <service android:name=".SourceActivity$SourceService" android:foregroundServiceType="mediaPlayback" android:exported="false" />
        <activity android:name=".ResearchFixtureActivity" android:exported="true" />
