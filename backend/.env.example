# Copy to .env inside backend/. Never put provider credentials in the APK.
ANYVOICE_ACCESS_TOKEN=replace-with-a-long-random-password
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
MURF_API_KEY=
# Public HTTPS address of THIS backend, for the agent's required inert LLM callback.
# No external LLM or translation model is called.
ANYVOICE_PUBLIC_URL=
MURF_SPEECH_RATE=15
# Fast route, or agora-engine to use Conversational AI voice orchestration.
VOICE_PROVIDER=murf-direct
MAX_SESSION_SECONDS=900

# Agora detects among up to four source languages; the chosen target passes through.
AUTO_SOURCE_LANGUAGES=en-IN,hi-IN,ta-IN,te-IN

# Optional Bubble microphone assistant (separate from translation).
DASHSCOPE_API_KEY=
BUBBLE_LLM_URL=https://ap-southeast-1.maas.qwencloudapi.com/compatible-mode/v1/chat/completions
BUBBLE_LLM_MODEL=qwen3.8-omni-flash

# Docker: mount the anyvoice-memory volume at /data.
BUBBLE_MEMORY_PATH=/data/bubble.sqlite3
